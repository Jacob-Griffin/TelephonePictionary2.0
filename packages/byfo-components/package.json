{
  "name": "byfo-components",
  "version": "1.0.2",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/byfo-components/byfo-components.esm.js",
  "files": [
    "dist/",
    "src/globals/css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/components/*",
    "./css/*": "./src/globals/css/*.css"
  },
  "scripts": {
    "build": "echo",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^21.1.0",
    "@stencil/core": "^4.11.0",
    "byfo-themes": "workspace:*",
    "byfo-utils": "workspace:*",
    "rollup": "2.56.3",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.13.4",
    "typescript": "5.7.3"
  },
  "license": "MIT"
}

{
  "rules": {
    "game":{
      ".read":true,
      ".write":true,
      "$gameid":{
        ".validate":"$gameid.matches(/^[0-9]{1,7}$/)",
        "players":{
          "__host":{
            ".validate":"newData.isString()",
          },
          "$name":{
            "from":{
              ".validate":"newData.isString()",
              "$others":{
                ".validate":false
              }
            },
            "to":{
              ".validate":"newData.isString()",
              "$others":{
                ".validate":false
              }
            },
            "$others":{
              ".validate":false
            }
          }
        },
        "round":{
          "roundnumber":{
            ".validate":"newData.isNumber() && newData.val()>=0",
            "$others":{
              ".validate":false
            }
          },
          "endTime":{
            ".validate":"newData.isNumber() && newData.val()>=-1",
            "$others":{
              ".validate":false
            }
          }
        },
        "staticRoundInfo":{
          "lastRound":{
            ".validate":"newData.isNumber() && newData.val()>=0",
            "$others":{
              ".validate":false
            }
          },
          "roundLength":{
            ".validate":"newData.isNumber() && newData.val()>=-1",
            "$others":{
              ".validate":false
            }
          }
        },
        "stacks":{
          "$author":{
             "$roundnumber":{
               "content":{
                 ".validate":"newData.isString()",
                 "$others":{
                   ".validate":false
                 }
               },
               "contentType":{
                 ".validate":"newData.isString()",
                 "$others":{
                   ".validate":false
                 }
               },
               "$others":{
                 ".validate":false
               }
             }
          }
        },
        "finished":{
          "$name":{
            ".validate":"newData.isNumber() && newData.val()>=-1"
          }
        },
        "isPrivate":{
          ".validate":"newData.isBoolean()"
        }
      }
    },
    "game-statuses":{
      ".read":true,
      ".write":true,
      "$gameid":{
        ".validate": "$gameid.matches(/^[0-9]{1,7}$/)",
      	"started":{
          ".validate":"newData.isBoolean()",
          "$others":{
            ".validate":false
          }
        },
        "finished":{
          ".validate":"newData.isBoolean()",
          "$others":{
          ".validate":false
        }
        },
        "$others":{
          ".validate":false
        }
      }
    },
    "players":{
      ".read":true,
      ".write":true,
      "$gameid":{
        ".validate": "$gameid.matches(/^[0-9]{1,7}$/)",
        "__host": {
          "username":{
            ".validate":"newData.isString()",
            "$others":{
              ".validate":false
            }
          },
        },
        "$playernumber":{
          ".validate":"$playernumber.matches(/^[0-9]{1,3}$/)",
          "username":{
            ".validate":"newData.isString()",
            "$others":{
              ".validate":false
            }
          },
          "status":{
            ".validate":"newData.isString()",
            "$others":{
              ".validate":false
            }
          },
          "$others":{
            ".validate":false
          }
        }
      }
    },
    "$others":{
      ".read":false,
        ".write":false
    }
  }
}